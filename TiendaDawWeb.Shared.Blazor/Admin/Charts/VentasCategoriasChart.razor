@namespace TiendaDawWeb.Shared.Blazor.Admin.Charts
@using TiendaDawWeb.Shared.Services.Stats
@using TiendaDawWeb.Shared.Dto.Stats
@using System.Timers
@implements IDisposable
@inject IStatisticsService StatsService
@inject ILogger<VentasCategoriasChart> Logger

<div class="card h-100 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-pie-chart-fill"></i> Ventas por Categoría</h5>
        <div>
            <span class="badge bg-light text-primary me-2">Auto-refresh: 30s</span>
            <button class="btn btn-sm btn-light" @onclick="ManualRefresh" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                }
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (isLoading && (Data == null || !Data.Any()))
        {
            <div class="d-flex justify-content-center align-items-center" style="height: 350px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (Data == null || !Data.Any())
        {
            <div class="d-flex flex-column justify-content-center align-items-center text-muted" style="height: 350px;">
                <i class="bi bi-graph-down display-4"></i>
                <p class="mt-2">No hay datos de ventas disponibles</p>
            </div>
        }
        else
        {
            <ApexChart TItem="CategorySalesDto" 
                        Title="Distribución de Ventas"
                        Options="Options">

                <ApexPointSeries TItem="CategorySalesDto"
                                Items="Data"
                                Name="Ventas"
                                SeriesType="SeriesType.Donut"
                                XValue="@(e => e.Categoria.ToString())"
                                YValue="@(e => e.Cantidad)" />
            </ApexChart>
        }
        <div class="text-end mt-2">
            <small class="text-muted fst-italic">Última actualización: @lastUpdate.ToString("HH:mm:ss")</small>
        </div>
    </div>
</div>

@code {
    private List<CategorySalesDto>? Data { get; set; }
    private ApexChartOptions<CategorySalesDto> Options { get; set; } = new();
    private DateTime lastUpdate = DateTime.Now;
    private bool isLoading = true;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Blazor VentasCategoriasChart: Inicializado");
        ConfigureOptions();
        await LoadData();

        _timer = new Timer(30000);
        _timer.Elapsed += async (s, e) => await InvokeAsync(AutoRefresh);
        _timer.AutoReset = true;
        _timer.Enabled = true;
    }

    private void ConfigureOptions()
    {
        Options.Chart = new Chart { Toolbar = new Toolbar { Show = true } };
        Options.Legend = new Legend { Position = LegendPosition.Bottom };
        Options.PlotOptions = new PlotOptions
        {
            Pie = new PlotOptionsPie
            {
                Donut = new PlotOptionsDonut
                {
                    Labels = new DonutLabels
                    {
                        Show = true,
                        Total = new DonutLabelTotal { Show = true, Label = "Total" }
                    }
                }
            }
        };
    }

    private async Task ManualRefresh()
    {
        Logger.LogInformation("🫱 Blazor VentasCategoriasChart: Refresco MANUAL solicitado");
        isLoading = true;
        await Task.Delay(300); 
        await LoadData();
        isLoading = false;
        StateHasChanged();
    }

    private async Task AutoRefresh()
    {
        Logger.LogInformation("⏱️ Blazor VentasCategoriasChart: Refresco AUTOMÁTICO por Timer");
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await StatsService.GetSalesByCategoryAsync();
            Data = result.ToList();
            lastUpdate = DateTime.Now;
            Logger.LogDebug("Blazor VentasCategoriasChart: Datos cargados correctamente");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blazor VentasCategoriasChart: Error al cargar datos");
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        Logger.LogInformation("Blazor VentasCategoriasChart: Eliminado (Dispose)");
        _timer?.Dispose();
    }
}
