@* 
    OBJETIVO: Configurar directivas compartidas por todas las páginas de Razor Pages (.cshtml).
    UBICACIÓN: Pages/
    RAZÓN: Aquí se registran los TagHelpers (como los de Bootstrap o Identity) y los namespaces 
    de los modelos y ViewModels. Al estar en la raíz de /Pages, garantiza que cualquier página 
    tenga acceso a estas herramientas sin configuración extra.
*@
@using TiendaDawWeb.Web.RazorPages
@using TiendaDawWeb
@using TiendaDawWeb.Shared.Models
@using TiendaDawWeb.Shared.ViewModels
@using TiendaDawWeb.Shared.Models.Enums
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using TiendaDawWeb.Resources
@using System.Globalization
@using System.Security.Claims
@* Alias para evitar conflictos con namespaces de carpetas *@
@using ProductModel = TiendaDawWeb.Shared.Models.Product
@using PurchaseModel = TiendaDawWeb.Shared.Models.Purchase
@namespace TiendaDawWeb.Web.RazorPages.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, TiendaDawWeb.Web.RazorPages
