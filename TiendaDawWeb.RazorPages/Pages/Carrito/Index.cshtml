@page
@model TiendaDawWeb.RazorPages.Pages.Carrito.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Carrito de Compras";
}

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="bi bi-cart3"></i> Mi Carrito de Compras
    </h1>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">
            <h4><i class="bi bi-cart-x"></i> Tu carrito está vacío</h4>
            <p>Añade productos para empezar a comprar.</p>
            <a asp-page="/Product/Index" class="btn btn-primary">
                <i class="bi bi-shop"></i> Ver Productos
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Productos en el carrito (@Model.Items.Count())</h5>
                    </div>
                    <div class="card-body" data-testid="cart-items">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row mb-3 border-bottom pb-3" data-testid="cart-item">
                                <div class="col-md-2">
                                    <img src="@item.Producto.ImagenOrDefault" 
                                         alt="@item.Producto.Nombre" 
                                         class="img-fluid rounded"
                                         data-testid="cart-item-image">
                                </div>
                                <div class="col-md-6">
                                    <h5 data-testid="cart-item-name">@item.Producto.Nombre</h5>
                                    <p class="text-muted small mb-1">@item.Producto.Descripcion</p>
                                    <span class="badge bg-secondary">@item.Producto.Categoria</span>
                                </div>
                                <div class="col-md-2 text-center">
                                    <label class="small text-muted">Precio</label>
                                    <p class="fw-bold text-primary">@item.Precio.ToString("C2", new CultureInfo("es-ES"))</p>
                                </div>
                                <div class="col-md-2 text-end">
                                    <form method="post" asp-page-handler="Remove" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-page="/Product/Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Seguir Comprando
                    </a>
                    <form method="post" asp-page-handler="Clear" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" 
                                onclick="return confirm('¿Estás seguro de vaciar el carrito?')">
                            <i class="bi bi-trash"></i> Vaciar Carrito
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Resumen del pedido</h5>
                    </div>
                    <div class="card-body" data-testid="order-summary">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span data-testid="subtotal">@ViewBag.Total.ToString("C2", new CultureInfo("es-ES"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Envío:</span>
                            <span class="text-success">GRATIS</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total:</strong>
                            <strong class="text-primary fs-4" data-testid="total">@ViewBag.Total.ToString("C2", new CultureInfo("es-ES"))</strong>
                        </div>

                        <a asp-page="/Carrito/Resumen" class="btn btn-primary w-100 mb-2" data-testid="checkout-button">
                            <i class="bi bi-arrow-right-circle"></i> Proceder al Pago
                        </a>

                        <div class="text-center small text-muted mt-3">
                            <i class="bi bi-shield-check"></i> Compra 100% segura
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-body">
                        <h6><i class="bi bi-truck"></i> Información de envío</h6>
                        <p class="small text-muted mb-0">
                            Los productos serán entregados en un plazo de 3-5 días laborables.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // No quantity changes needed - products can only be added once
    </script>
}
