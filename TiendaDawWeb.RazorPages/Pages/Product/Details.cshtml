@page "{id:long}"
@attribute [OutputCache(Duration = 600)]
@using Microsoft.AspNetCore.OutputCaching
@using TiendaDawWeb.Shared.Blazor.Ratings
@using TiendaDawWeb.Shared.Helpers
@model TiendaDawWeb.RazorPages.Pages.Product.DetailsModel
@inject UserManager<User> UserManager
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["Title"] = Model.Product?.Nombre ?? "Producto";
    var currentUser = await UserManager.GetUserAsync(User);
    var isOwner = currentUser != null && Model.Product != null && Model.Product.PropietarioId == currentUser.Id;
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var productId = Model.Product?.Id;
    var productoVendido = Model.Product?.CompraId.HasValue ?? false;
}

<!-- CONTEXTO PARA SCRIPTS EXTERNOS -->

@section Scripts
{
    @* Script original para AJAX comentado para propósitos didácticos *@
    @* 
    <script>
        window.isAuthenticated = @isAuthenticated.ToString().ToLower();
        window.isOwner = @isOwner.ToString().ToLower();
        window.productId = @productId;
    </script>
    *@
}

<div class="container mt-4" data-testid="product-details-page">
    @if (Model.Product == null) {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> El producto no existe o ha sido eliminado.
            <a asp-page="/Public/Index" class="alert-link">Volver al inicio</a>
        </div>
    }
    else {
        <div class="row">
            <div class="col-md-6">
                <img src="@Model.Product.ImagenOrDefault" class="img-fluid rounded shadow" alt="@Model.Product.Nombre"
                     data-testid="product-image">
            </div>

            <div class="col-md-6">
                <h1 class="mb-3" data-testid="product-title">@Model.Product.Nombre</h1>
                <div class="mb-3 d-flex gap-2">
                    <span class="badge bg-secondary"
                          data-testid="product-category">@SharedLocalizer[$"Category.{Model.Product.Categoria}"]</span>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-calendar3"></i> @SharedLocalizer["Created"]: @Model.Product.CreatedAt.ToLocalTime().ToString("g")
                    </span>
                    @if (isAuthenticated && Model.Product.CompraId.HasValue) {
                        <span class="badge bg-danger">
                            <i class="bi bi-check-circle"></i> VENDIDO
                        </span>
                    }
                </div>

                <div id="averageRatingHeader" class="mb-4">
                    @* Código original con AJAX comentado para propósitos didácticos *@
                    @* <script>loadRatings();</script> *@

                    <component type="typeof(RatingSummary)"
                               render-mode="ServerPrerendered"
                               param-ProductId="@Model.Product.Id"/>
                </div>

                <h2 class="text-primary mb-4"
                    data-testid="product-price">@PriceFormatter.FormatPrice(Model.Product.Precio)</h2>

                <div class="mb-4">
                    <h5>Descripción</h5>
                    <p data-testid="product-description">@Model.Product.Descripcion</p>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-person"></i> Vendedor</h5>
                    </div>
                    <div class="card-body" data-testid="seller-info">
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(Model.Product.Propietario.Avatar)) {
                                <img src="@Model.Product.Propietario.Avatar" alt="Avatar" class="rounded-circle me-3"
                                     style="width: 50px; height: 50px; object-fit: cover;">
                            }
                            <div>
                                <strong
                                    data-testid="seller-name">@Model.Product.Propietario.Nombre @Model.Product.Propietario.Apellidos</strong>
                                <br>
                                <small class="text-muted"
                                       data-testid="seller-email">@Model.Product.Propietario.Email</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-3">
                    @if (isOwner) {
                        <a href="@Url.Page("/Product/Edit", new { id = Model.Product.Id })" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Product.Id"
                              onsubmit="return confirm('¿Estás seguro de que quieres eliminar este producto?');">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </form>
                    }
                    else if (Model.Product.CompraId.HasValue) {
                        <button class="btn btn-secondary" disabled>
                            <i class="bi bi-check-circle"></i> Producto Vendido
                        </button>
                    }
                    else if (Model.Product.Reservado) {
                        <button class="btn btn-secondary" disabled>
                            <i class="bi bi-lock"></i> Producto Reservado
                        </button>
                    }
                    else {
                        <form method="post" asp-page-handler="Add" asp-route-productoId="@Model.Product.Id"
                              class="flex-grow-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100" data-testid="add-to-cart-button">
                                <i class="bi bi-cart-plus"></i> Añadir al Carrito
                            </button>
                        </form>
                    }

                    @if (isAuthenticated && !isOwner) {
                        var isFavorite = ViewBag.IsFavorite ?? false;
                        <button class="btn @(isFavorite ? "btn-danger" : "btn-outline-danger") favorite-btn"
                                data-product-id="@Model.Product.Id"
                                onclick="toggleFavorite(@Model.Product.Id)" data-testid="favorite-button">
                            <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i> Favorito
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12">
                @* Código original con AJAX comentado para propósitos didácticos *@
                @* 
            <div id="ratingSectionAJAX" class="mb-4"></div>
            <div id="ratingsListAJAX"></div> 
            *@

                <component type="typeof(RatingSection)"
                           render-mode="ServerPrerendered"
                           param-ProductId="@Model.Product.Id"
                           param-CurrentUserId="@currentUser?.Id"
                           param-IsOwner="@isOwner"
                           param-IsAuthenticated="@isAuthenticated"
                           param-ProductUrl="@(Url.Page("/Product/Details", new { id = Model.Product.Id }))"/>
            </div>
        </div>
    }
</div>